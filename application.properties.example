# ============================================================
# B站 DeepSeek 评论区机器人 - 配置文件
#
# 本文件会在 jar 首次运行时自动生成到 jar 同级目录。
# 每次启动时，程序会自动补全缺失的配置项，不会覆盖已有值。
# 本文件包含登录凭据，请勿提交到公开仓库或发给他人。
# ============================================================

# ---------- 登录与必填项 ----------

# 登录方式：auto / qrcode / password / cookie
# auto     ：缓存会话 -> Cookie -> 有账号密码则密码登录 -> 二维码
# qrcode   ：缓存会话 -> Cookie -> 二维码
# password ：缓存会话 -> Cookie -> 账号密码
# cookie   ：只用缓存会话或配置的 Cookie
bilibili.login-type=auto

# 方式一：机器人账号的登录账号（手机号或邮箱）。
# B站密码登录强制要求一次极验人机验证；程序会在终端提示你完成验证，
# 成功后 Cookie 会缓存到 app.session-file，后续启动不需要重复验证。
bilibili.username=

# 机器人账号密码。注意：这里保存的是明文密码，请务必保护好配置文件。
# 如果密码中包含反斜杠，需要在 properties 文件中写成双反斜杠，或改用环境变量 BILI_PASSWORD。
bilibili.password=

# 方式二：二维码登录。不需要填写账号密码或 Cookie，程序会在终端显示二维码。
# 适合有交互式终端的场景；扫码成功后会话同样缓存到 app.session-file。

# 方式三：机器人账号的完整 Cookie。适合无人值守服务器。
# 至少包含 SESSDATA 和 bili_jct。
# 获取方式：登录机器人账号 -> 打开 https://message.bilibili.com/ -> F12 网络 -> 复制请求头 Cookie。
bilibili.cookie=

# 主人账号 UID。只有这个 UID 在评论区 @ 机器人时才会触发回复。
# 打开主人主页 https://space.bilibili.com/123456789，地址中的数字即 UID。
bilibili.owner-uid=0

# DeepSeek API Key，从 https://platform.deepseek.com/ 创建。
deepseek.api-key=


# ---------- 常用行为 ----------

# true：只把拟回复写入日志，不实际发表评论。首次使用建议保持 true。
bilibili.dry-run=true

# 轮询 @ 消息的间隔（秒），不建议小于 30，避免触发风控。
bilibili.poll-interval-seconds=45

# 首次启动时是否处理已经存在的历史 @。
# false：跳过历史消息；true：处理 max-mention-age-minutes 范围内的历史消息。
bilibili.process-existing=false

# 首次启动时，最近多少秒内到达的 @ 仍视为新消息并处理。
bilibili.first-run-grace-seconds=120

# 超过多少分钟的 @ 不再回复。
bilibili.max-mention-age-minutes=120

# 是否要求评论内容或 at 详情中确实包含对机器人的 @。
bilibili.require-bot-mention=true

# 是否监听“回复我的”：主人直接在机器人回复下继续回复时，无需 @ 也能继续对话。
bilibili.reply-feed-enabled=true

# 是否允许主人以外的人 @ 机器人并对话。开启后网友会被称为“网友”，不会被叫“主人”。
# 注意：公开机器人可能被陌生人刷屏并消耗 DeepSeek 额度，建议按需开启。
bilibili.allow-other-users=false

# 是否开启私聊自动回复。任何人都可以私聊机器人并收到回复。
# 私聊发送使用 B 站非公开接口，可能受风控影响，建议先用 dry-run 观察。
bilibili.private-message-enabled=false

# 私聊轮询间隔（秒）和每次读取的聊天记录条数。
bilibili.private-message-poll-seconds=60
bilibili.private-message-history-size=8

# 读取评论串中最近多少条回复作为上下文，0 表示关闭。
bilibili.thread-context-size=12

# 同一条 @ 遇到可重试错误时，最多尝试几轮。
bilibili.max-attempts=3

# 额外的 @ 触发别名，逗号分隔，通常留空。
bilibili.trigger-aliases=


# ---------- DeepSeek 模型 ----------

deepseek.base-url=https://api.deepseek.com
deepseek.model=deepseek-chat
deepseek.temperature=0.8
deepseek.max-tokens=800
deepseek.timeout-seconds=90
deepseek.max-retries=2


# ---------- 回复格式 ----------

# B站评论最多 1000 字，建议保留余量。
reply.max-length=900

# 回复开头是否 @ 主人。默认 false：二级评论会自然通知主人，避免重复 @。
reply.mention-owner=false

# 可选固定前缀，例如【AI】；留空表示不加。
reply.prefix=

# 模型返回空内容时使用的兜底回复。
reply.fallback-text=叽里呱啦说啥呢，去，给我买白饭去

# 人设文件。首次启动会自动生成在配置文件/jar 同级目录，可直接编辑。
# 修改保存后无需重启，下一条 @ 回复会自动使用新的人设。
reply.system-prompt-file=persona.txt

# 提供给模型的评论串上下文最大字符数。
reply.max-context-chars=3000


# ---------- 高级选项 ----------

# 单次请求 B 站接口的超时时间（秒）。
bilibili.request-timeout-seconds=20

# 浏览器 User-Agent，一般不需要修改。
bilibili.user-agent=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36

# 请求 B 站时使用的 Referer。
bilibili.referer=https://www.bilibili.com/

# @ 消息接口地址，一般不需要修改。
bilibili.at-feed-url=https://api.bilibili.com/x/msgfeed/at

# 回复消息接口地址，一般不需要修改。
bilibili.reply-feed-url=https://api.bilibili.com/x/msgfeed/reply

# 去重状态文件路径。相对路径以程序工作目录为基准。
app.state-file=data/state.json

# 账号密码登录成功后的 Cookie 缓存，避免每次启动都重复人机验证。
# 该文件包含登录凭据，请不要公开。
app.session-file=data/session.json


# ---------- 请求保护 ----------

# 全局请求保护：最小间隔、读写额度、写冷却、重复写拦截、412/429 暂停。
risk.enabled=true
risk.min-gap-ms=1500
risk.read-hourly=600
risk.read-daily=3000
risk.write-hourly=12
risk.write-daily=30
risk.write-gap-seconds=120
risk.dedup-hours=24
risk.state-file=data/traffic.json


# ---------- 收藏夹推荐 ----------

# 是否扫描主人的公开收藏夹，查找相关视频并写入推荐文件。
# 只读取公开收藏夹；私密收藏夹需要主人账号权限，当前不支持。
recommend.enabled=false

# 每隔多少分钟扫描一次，默认 12 小时。
recommend.interval-minutes=720

# 最多扫描多少个收藏夹。留空 favorite-folders 时自动取前 N 个公开收藏夹。
recommend.max-folders=5

# 每个收藏夹取最近多少个视频作为偏好样本。
recommend.samples-per-folder=5

# 每个样本视频最多取多少个相关推荐。
recommend.related-limit=10

# 每次最多保留多少个推荐结果，以及 AI 评分门槛（0-100）。
recommend.max-results=3
recommend.min-score=70

# 指定收藏夹 media_id，逗号分隔；留空表示自动选择公开收藏夹。
recommend.favorite-folders=

# 推荐结果输出文件，只写日志和 JSON，不会自动私聊发送。
recommend.output-file=data/recommendations.json
